[Unit]
Description=FileTagger AI File Manager Daemon
Documentation=https://github.com/akinus21/filetagger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The venv is created by blueak-init.sh on first login
ExecStart=/usr/local/bin/filetagger start --fg
Restart=on-failure
RestartSec=10
# Pick up FILETAGGER_OLLAMA_URL and friends from environment.d
EnvironmentFile=-%h/.config/environment.d/filetagger.conf

[Install]
WantedBy=default.target
