#!/usr/bin/env python3
"""
set-nyxt-theme — Apply a Nyxt color theme from a JSON file.

Usage:
  set-nyxt-theme <theme-name>   Apply theme (e.g. eldritch, dracula, nord, noctalia)
  set-nyxt-theme list           Show available themes
  set-nyxt-theme show            Show current theme
  set-nyxt-theme sync-noctalia   Sync Noctalia live colors to Nyxt theme

Theme JSON format:
  {
    "name": "Eldritch",
    "colors": {
      "background": "#212337",
      "foreground": "#eceff4",
      "primary": "#323449",
      "secondary": "#7081d0",
      "success": "#37f499",
      "warning": "#e9f941",
      "highlight": "#f265b5",
      "text": "#ebfafa",
      "contrast-text": "#212337"
    }
  }

Special themes:
  noctalia  — reads live Noctalia colors from ~/.config/noctalia/colors.json
              so Nyxt tracks Noctalia-gtk daemon changes in real time
"""

import json
import os
import sys
from pathlib import Path

THEME_DIR = Path.home() / ".config/nyxt/themes"
THEME_LISP = Path.home() / ".config/nyxt" / "theme.lisp"
CURRENT_MARKER = THEME_DIR / "current"
NOCTALIA_COLORS = Path.home() / ".config" / "noctalia" / "colors.json"


def list_themes():
    themes = sorted(THEME_DIR.glob("*.json"))
    if not themes:
        print("No themes found in", THEME_DIR)
        return
    current = get_current_theme()
    for t in themes:
        name = t.stem
        marker = " [current]" if name == current else ""
        try:
            data = json.loads(t.read_text())
            desc = data.get("description", "")
            print(f"  {name:12} — {desc}{marker}")
        except Exception:
            print(f"  {name:12}{marker}")


def get_current_theme():
    try:
        return CURRENT_MARKER.read_text().strip()
    except Exception:
        return ""


def show_current():
    current = get_current_theme()
    if not current:
        print("No theme selected")
        return
    theme_file = THEME_DIR / f"{current}.json"
    if theme_file.exists():
        data = json.loads(theme_file.read_text())
        print(f"Current theme: {data.get('name', current)} ({current})")
    else:
        print(f"Current theme: {current} (file not found)")


def read_noctalia_colors():
    """Read live Noctalia colors.json and map to Nyxt theme slots."""
    if not NOCTALIA_COLORS.exists():
        print(f"Noctalia colors not found at {NOCTALIA_COLORS}")
        sys.exit(1)
    try:
        nc = json.loads(NOCTALIA_COLORS.read_text())
    except json.JSONDecodeError as e:
        print(f"Invalid JSON in {NOCTALIA_COLORS}: {e}")
        sys.exit(1)

    colors = nc.get("colors", nc)  # handle both flat and nested formats
    # Support Noctalia's m* prefix or bare keys
    def get(key, fallback):
        return colors.get(key) or colors.get(f"m{key.title()}") or colors.get(f"m{key}", fallback) or fallback

    return {
        "background": get("Background", "#212337"),
        "foreground": get("OnBackground", "#ebfafa"),
        "primary": get("Surface", "#323449"),
        "secondary": get("Secondary", "#7081d0"),
        "success": get("Success", "#37f499"),
        "warning": get("Warning", "#e9f941"),
        "highlight": get("Highlight", "#f265b5"),
        "text": get("OnBackground", "#ebfafa"),
        "contrast-text": get("Background", "#212337"),
    }


def generate_lisp(colors: dict) -> str:
    bg = colors.get("background", "#000000")
    fg = colors.get("foreground", "#ffffff")
    primary = colors.get("primary", "#333333")
    secondary = colors.get("secondary", "#888888")
    success = colors.get("success", "#00ff00")
    warning = colors.get("warning", "#ffff00")
    highlight = colors.get("highlight", "#ff00ff")
    text = colors.get("text", "#ffffff")
    contrast = colors.get("contrast-text", "#000000")
    return f""";; Generated by set-nyxt-theme — DO NOT EDIT DIRECTLY
;; Source: ~/.config/noctalia/colors.json (Noctalia live theme)
;; To change theme, run: set-nyxt-theme <theme-name>

(define-configuration browser
  ((theme (make-instance 'theme:theme
    :dark-p t
    :background-color     "{bg}"
    :on-background-color  "{fg}"
    :primary-color        "{primary}"
    :on-primary-color     "{fg}"
    :secondary-color       "{secondary}"
    :on-secondary-color    "{fg}"
    :success-color         "{success}"
    :warning-color         "{warning}"
    :highlight-color       "{highlight}"
    :text-color            "{text}"
    :contrast-text-color   "{contrast}"))))
"""


def apply_theme(theme_name: str):
    if theme_name == "noctalia":
        colors = read_noctalia_colors()
        lisp = generate_lisp(colors)
        THEME_LISP.parent.mkdir(parents=True, exist_ok=True)
        THEME_LISP.write_text(lisp)
        CURRENT_MARKER.write_text("noctalia")
        print(f"Theme applied: Noctalia (live sync from ~/.config/noctalia/colors.json)")
        print(f"Config written to: {THEME_LISP}")
        return

    theme_file = THEME_DIR / f"{theme_name}.json"
    if not theme_file.exists():
        print(f"Theme '{theme_name}' not found in {THEME_DIR}")
        print("Run 'set-nyxt-theme list' to see available themes.")
        sys.exit(1)

    try:
        data = json.loads(theme_file.read_text())
    except json.JSONDecodeError as e:
        print(f"Invalid JSON in {theme_file}: {e}")
        sys.exit(1)

    colors = data.get("colors", {})
    bg = colors.get("background", "#000000")
    fg = colors.get("foreground", "#ffffff")
    primary = colors.get("primary", "#333333")
    secondary = colors.get("secondary", "#888888")
    success = colors.get("success", "#00ff00")
    warning = colors.get("warning", "#ffff00")
    highlight = colors.get("highlight", "#ff00ff")
    text = colors.get("text", "#ffffff")
    contrast = colors.get("contrast-text", "#000000")

    lisp = f""";; Generated by set-nyxt-theme — DO NOT EDIT DIRECTLY
;; Source: {theme_file}

(define-configuration browser
  ((theme (make-instance 'theme:theme
    :dark-p t
    :background-color     "{bg}"
    :on-background-color  "{fg}"
    :primary-color        "{primary}"
    :on-primary-color     "{fg}"
    :secondary-color       "{secondary}"
    :on-secondary-color    "{fg}"
    :success-color         "{success}"
    :warning-color         "{warning}"
    :highlight-color       "{highlight}"
    :text-color            "{text}"
    :contrast-text-color   "{contrast}"))))
"""

    THEME_LISP.parent.mkdir(parents=True, exist_ok=True)
    THEME_LISP.write_text(lisp)
    CURRENT_MARKER.write_text(theme_name)

    print(f"Theme applied: {data.get('name', theme_name)} ({theme_name})")
    print(f"Config written to: {THEME_LISP}")


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd == "list":
        list_themes()
    elif cmd == "show":
        show_current()
    elif cmd == "sync-noctalia":
        apply_theme("noctalia")
    elif cmd in ("-h", "--help"):
        print(__doc__)
    else:
        apply_theme(cmd)


if __name__ == "__main__":
    main()